
#include <stdio.h>

struct student
{
    int roll;
    char name[50];
    int m1, m2, m3;
};

int main()
{
    struct student s[50];
    int n, i, total;
    float percentage;

   printf("Enter number of students: ");
    scanf("%d", &n);

   if(n < 1 || n > 50)
    {
        printf("Enter a number between 1 and 50");
        return 0;
    }

   for(i = 0; i < n; i++)
    {
   printf("\nEnter details of student %d:\n", i + 1);

   printf("Enter roll number: ");
        scanf("%d", &s[i].roll);

  printf("Enter name: ");
        scanf("%49s", s[i].name);

  printf("Enter marks of three subjects: ");
        scanf("%d %d %d", &s[i].m1, &s[i].m2, &s[i].m3);
    }

   printf("\n===== STUDENT MARKSHEET =====\n");
    printf("Roll No\tName\tTotal\tPercentage\n");

   for(i = 0; i < n; i++)
    {
        total = s[i].m1 + s[i].m2 + s[i].m3;
        percentage = total / 3.0;

  printf("%d\t%s\t%d\t%.2f%%\n",
               s[i].roll, s[i].name, total, percentage);
    }

   return 0;
}
